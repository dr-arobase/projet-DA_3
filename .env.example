# Copier en .env (jamais commis) pour remplacer les valeurs par défaut de compose.yaml.
# Sans .env, `docker compose up` fonctionne avec des valeurs de développement local.

# Port de l'application sur la machine hôte
PORT=3000

# Mot de passe de PostgreSQL (lu au PREMIER démarrage du volume seulement)
POSTGRES_PASSWORD=crimetracker

# Clé qui signe les cookies de session : une longue chaîne aléatoire, ex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Pour lancer le serveur hors Docker (npm run dev dans backend/) :
# DATABASE_URL=postgres://crimetracker:crimetracker@localhost:5432/crimetracker
# Mettre à true derrière HTTPS : le cookie de session n'est alors envoyé qu'en HTTPS.
# COOKIE_SECURE=false
