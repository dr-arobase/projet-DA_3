# Copier en .env à la racine pour changer les valeurs par défaut de compose.yml.
# Le fichier .env n'est pas versionné : il peut contenir des secrets.

# Mot de passe de la base (utilisé à la PREMIÈRE création du volume seulement)
POSTGRES_PASSWORD=crimetracker

# Clé obligatoire qui signe les jetons de session. Remplacez cette valeur vide
# par une valeur aléatoire (32 octets ou plus sont recommandés).
JWT_SECRET=

# Origines exactes autorisées à ouvrir Socket.IO (séparées par des virgules)
SOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# true uniquement si l'application est servie en HTTPS
COOKIE_SECURE=false

# Port du navigateur : http://localhost:8080
CLIENT_PORT=8080

# Connexion GitHub (OAuth 2). Créer une OAuth App : GitHub > Settings > Developer settings >
# OAuth Apps > New OAuth App, avec « Authorization callback URL » égale à GITHUB_CALLBACK_URL.
# Identifiant public de l'application OAuth
GITHUB_CLIENT_ID=identifiant-de-l-application-oauth
# Secret de l'application OAuth : reste sur le serveur, ne jamais le commettre
GITHUB_CLIENT_SECRET=secret-de-l-application-oauth
# Adresse où GitHub renvoie l'agent après l'autorisation (doit correspondre à l'OAuth App)
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
