# Copier en .env à la racine pour changer les valeurs par défaut de compose.yml.
# Le fichier .env n'est pas versionné : il peut contenir des secrets.
# Toutes les valeurs ci-dessous sont des exemples : aucune n'est un vrai secret.

# --- Base de données ---
# Mot de passe de la base (utilisé à la PREMIÈRE création du volume seulement)
POSTGRES_PASSWORD=crimetracker

# --- Sessions ---
# Clé qui signe les jetons de session. La valeur ci-dessous est un exemple, à remplacer par une
# vraie clé aléatoire (32 octets ou plus). Ne jamais commettre la vraie :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=exemple-a-remplacer-par-une-cle-aleatoire
# Clé de chiffrement des secrets de la double authentification (facultative : sans elle, JWT_SECRET sert).
# À définir pour pouvoir changer JWT_SECRET sans perdre les doubles authentifications actives.
TOTP_KEY=

# Origines exactes autorisées pour Socket.IO et les requêtes HTTP mutantes (séparées par des virgules)
SOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# true uniquement si l'application est servie en HTTPS (le cookie de session n'est alors envoyé qu'en HTTPS)
COOKIE_SECURE=false

# Port du navigateur : http://localhost:8080
CLIENT_PORT=8080

# --- Connexion GitHub (OAuth 2) ---
# Créer une OAuth App : GitHub > Settings > Developer settings > OAuth Apps > New OAuth App,
# avec « Authorization callback URL » égale à GITHUB_CALLBACK_URL. Une OAuth App n'accepte qu'une
# adresse de retour : il en faut une pour localhost et une autre pour le site en ligne.
# Identifiant public de l'application OAuth
GITHUB_CLIENT_ID=identifiant-de-l-application-oauth
# Secret de l'application OAuth : reste sur le serveur, ne jamais le commettre
GITHUB_CLIENT_SECRET=secret-de-l-application-oauth
# Adresse où GitHub renvoie l'agent après l'autorisation (doit correspondre à l'OAuth App)
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# --- Relais TURN des appels (facultatif) ---
# Sans ces deux variables, les appels n'utilisent que STUN : ils marchent sur un même réseau,
# mais souvent pas entre un téléphone en 4G/5G et un ordinateur. Le serveur TURN (coturn) se lance
# avec deploy/compose.yml (COMPOSE_PROFILES=turn, voir deploy/.env.example).
# Pour l'activer, décommenter les deux lignes et remplacer les valeurs d'exemple.
# Adresses données aux navigateurs, séparées par des virgules
# TURN_URLS=turn:exemple.votre-domaine.ca:3478?transport=udp,turn:exemple.votre-domaine.ca:3478?transport=tcp
# Secret partagé avec coturn (ex. : openssl rand -hex 32)
# TURN_SECRET=exemple-de-secret-turn

# --- Démarrage sans Docker (backend/.env, avec npm run dev dans backend/) ---
# Ces variables ne servent pas avec docker compose : compose.yml les fixe lui-même.
# DATABASE_URL=postgres://crimetracker:crimetracker@localhost:5432/crimetracker
# PORT=3000
# Service de géocodage des adresses (par défaut : Nominatim d'OpenStreetMap)
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
