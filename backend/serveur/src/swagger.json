{
  "openapi": "3.0.3",
  "info": {
    "title": "CrimeTracker API",
    "version": "1.0.0",
    "description": "API REST du registre national des personnes recherchées.\n\nLes routes sont basées sur `docs/03-conception.md`. Les routes marquées **[À implémenter]** sont prévues dans la conception mais pas encore codées.\n\n### Authentification\nObtenir un jeton via `POST /api/auth/login`, puis cliquer sur **Authorize** et coller le jeton.\n\n### Rôles\n- `policier` : grade `sergent_autres_fonctions`\n- `superviseur` : grades `sergent_gestionnaire` à `inspecteur_chef`\n- `direction` : grades `directeur_general_adjoint` et `directeur_general`\n\n### Événements Socket.IO (sprints 2–3)\n| Direction | Événement | Payload | Déclencheur |\n|---|---|---|---|\n| Serveur → clients | `criminal:added` | `{ criminal }` | Nouveau dossier créé |\n| Serveur → clients | `criminal:updated` | `{ id, status, updated_by, updated_at }` | Statut modifié |\n| Serveur → clients | `criminal:removed` | `{ id }` | Dossier retiré |\n| Serveur → clients | `alert:broadcast` | `{ id, message, severity, issued_by, created_at }` | Alerte urgente émise |\n| Serveur → clients | `presence:update` | `{ online_users[] }` | Connexion / déconnexion |\n| Client → serveur | `alert:send` | `{ message, severity, criminal_id? }` | Superviseur diffuse une alerte |"
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Serveur local" }],
  "tags": [
    { "name": "Auth", "description": "Connexion et déconnexion" },
    { "name": "Criminals", "description": "Registre des personnes recherchées" },
    { "name": "Sightings", "description": "Signalements d'observation sur le terrain" },
    { "name": "Messages", "description": "Messagerie privée entre agents" },
    { "name": "Users", "description": "Gestion des comptes policiers et superviseurs" },
    { "name": "Audit", "description": "Journal des actions sensibles" },
    { "name": "Dossiers", "description": "Routes codées dans routes/dossier.js — **non montées dans app.js** (répondent 404 pour l'instant) et en doublon avec /api/criminals" },
    { "name": "Système", "description": "Vérification de l'état de l'API" },
    { "name": "Alerts", "description": "Alertes diffusées en temps réel" }
  ],
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
  "paths": {
    "/": {
      "get": {
        "tags": ["Système"],
        "summary": "Vérifier que l'API est opérationnelle",
        "security": [],
        "responses": {
          "200": {
            "description": "API opérationnelle",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "API CrimeTracker opérationnelle" },
                    "documentation": { "type": "string", "example": "/api-docs" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authentification d'un policier",
        "description": "Vérifie le matricule et le mot de passe (bcrypt) d'un compte actif et retourne un jeton JWT valide 8 heures.\n\nPose aussi le cookie httpOnly `crimetracker_session`. Avec `se_souvenir: true`, le cookie dure 8 h ; sinon il disparaît à la fermeture du navigateur.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Identifiants invalides ou compte inactif",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Déconnexion de l'agent",
        "description": "Efface le cookie de session.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Déconnexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Déconnexion réussie. Le jeton doit être supprimé côté client."
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Profil de l'agent connecté",
        "description": "Permet au frontend de vérifier que sa session (cookie) est toujours valide. Un compte désactivé depuis la connexion reçoit 401.",
        "responses": {
          "200": {
            "description": "Agent connecté",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Changer son mot de passe",
        "description": "L'agent connecté confirme son mot de passe actuel et en choisit un nouveau (8 caractères minimum, différent de l'ancien). La session reste active.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["old_password", "new_password"],
                "properties": {
                  "old_password": { "type": "string", "example": "ancienMotDePasse" },
                  "new_password": { "type": "string", "minLength": 8, "example": "nouveauMotDePasse" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mot de passe mis à jour" },
          "400": { "description": "Champs manquants, mot de passe trop court, identique à l'ancien ou mot de passe actuel incorrect" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/auth/avatar": {
      "put": {
        "tags": ["Auth"],
        "summary": "Changer sa photo de profil",
        "description": "Le corps de la requête est l'image brute (pas de multipart). JPG, PNG ou WebP, 2 Mo maximum. L'ancienne photo est supprimée. L'image est ensuite servie sous avatar_url, réservée aux agents connectés.",
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
            "image/png": { "schema": { "type": "string", "format": "binary" } },
            "image/webp": { "schema": { "type": "string", "format": "binary" } }
          }
        },
        "responses": {
          "200": {
            "description": "Photo enregistrée",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" }, "user": { "$ref": "#/components/schemas/User" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "413": { "description": "Image de plus de 2 Mo" },
          "415": { "description": "Ce n'est pas une image JPG, PNG ou WebP valide" }
        }
      },
      "delete": {
        "tags": ["Auth"],
        "summary": "Supprimer sa photo de profil",
        "description": "L'interface revient aux initiales de l'agent.",
        "responses": {
          "200": {
            "description": "Photo supprimée",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" }, "user": { "$ref": "#/components/schemas/User" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/criminals": {
      "get": {
        "tags": ["Criminals"],
        "summary": "Liste des personnes recherchées",
        "description": "Liste paginée des dossiers, avec filtre optionnel sur le statut. Les champs added_by / updated_by contiennent le nom de l'agent.",
        "responses": {
          "200": {
            "description": "Page de dossiers",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Paginated" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Criminal" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        },
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/CriminalStatus" }
          }
        ]
      },
      "post": {
        "tags": ["Criminals"],
        "summary": "Créer un dossier",
        "description": "Crée un dossier au nom de l'agent connecté et diffuse l'événement Socket.IO `criminal:added`.\n\n**Rôle requis :** `policier`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CriminalCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dossier créé avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Dossier créé avec succès" },
                    "criminal": { "$ref": "#/components/schemas/Criminal" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/criminals/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Criminals"],
        "summary": "Détail d'un dossier",
        "description": "Récupère les informations d'un criminel par son ID.",
        "responses": {
          "200": {
            "description": "Dossier trouvé",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Criminal" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "tags": ["Criminals"],
        "summary": "Mettre à jour un dossier",
        "description": "Met à jour les informations du dossier (sans le statut) et diffuse `criminal:updated`.\n\n**Rôle requis :** `superviseur`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CriminalUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dossier mis à jour avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Dossier mis à jour avec succès" },
                    "criminal": { "$ref": "#/components/schemas/Criminal" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Criminals"],
        "summary": "Retirer un dossier",
        "description": "Supprime le dossier, l'inscrit au journal d'audit et diffuse `criminal:removed`.\n\n**Rôle requis :** `superviseur`",
        "responses": {
          "200": {
            "description": "Dossier retiré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Dossier retiré avec succès" },
                    "id": { "type": "integer", "example": 1 }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/criminals/{id}/status": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "patch": {
        "tags": ["Criminals"],
        "summary": "Changer le statut d'un dossier",
        "description": "Verrouillage optimiste : le client envoie la `version` qu'il a lue. Si le dossier a changé entre-temps, la requête est refusée (409) avec l'état courant. Diffuse `criminal:updated`.\n\n**Rôle requis :** `policier`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CriminalStatusUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statut mis à jour avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Statut mis à jour avec succès" },
                    "criminal": { "$ref": "#/components/schemas/Criminal" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Conflit de version",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VersionConflict" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/sightings": {
      "post": {
        "tags": ["Sightings"],
        "summary": "Signaler une observation",
        "description": "Enregistre une observation terrain (lieu, heure, notes) d'une personne recherchée (récit #11).\n\n**Rôle requis :** `policier`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SightingCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signalement enregistré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "sighting": { "$ref": "#/components/schemas/Sighting" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "get": {
        "tags": ["Sightings"],
        "summary": "Historique des signalements d'un dossier",
        "description": "Du plus récent au plus ancien.\n\n**Rôle requis :** `superviseur`",
        "parameters": [
          {
            "name": "criminal_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Signalements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Sighting" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/sightings/recent": {
      "get": {
        "tags": ["Sightings"],
        "summary": "Derniers signalements, tous dossiers (carte)",
        "description": "Du plus récent au plus ancien, avec la position quand elle est connue. Événement Socket.IO `sighting:added` à chaque nouveau signalement.\n\n**Rôle requis :** `policier`",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 200, "minimum": 1, "maximum": 500 } }
        ],
        "responses": {
          "200": {
            "description": "Signalements",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Sighting" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/messages/contacts": {
      "get": {
        "tags": ["Messages"],
        "summary": "Agents à qui écrire",
        "description": "Agents actifs (sauf soi), avec le nombre de messages non lus reçus de chacun et la date du dernier échange; conversations récentes en premier.\n\n**Rôle requis :** `policier`",
        "responses": {
          "200": {
            "description": "Contacts",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Contact" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/messages/{userId}": {
      "get": {
        "tags": ["Messages"],
        "summary": "Conversation avec un agent",
        "description": "Les 200 derniers messages, du plus ancien au plus récent. Les messages reçus de cet agent passent à « lus » (événement `message:read` envoyé à l'expéditeur).\n\n**Rôle requis :** `policier`",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Messages",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/messages": {
      "post": {
        "tags": ["Messages"],
        "summary": "Envoyer un message privé",
        "description": "Le destinataire et l'expéditeur le reçoivent en direct (événement Socket.IO `message:new`, envoyé à eux seuls).\n\n**Rôle requis :** `policier`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["recipient_id", "body"],
                "properties": {
                  "recipient_id": { "type": "integer", "example": 2 },
                  "body": { "type": "string", "maxLength": 2000, "example": "Suspect vu au métro Berri-UQAM." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message envoyé",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "message": { "type": "string" }, "data": { "$ref": "#/components/schemas/Message" } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Liste des comptes",
        "description": "Liste des comptes policiers et superviseurs.\n\n**Rôle requis :** `superviseur` ou `direction`",
        "responses": {
          "200": {
            "description": "Liste des comptes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Créer un compte policier",
        "description": "Crée le compte d'un nouveau policier (récit #8). Le rôle est `policier` et le grade `sergent_autres_fonctions`.\n\n**Rôle requis :** `superviseur`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compte créé",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "Matricule déjà utilisé",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/audit-logs": {
      "get": {
        "tags": ["Audit"],
        "summary": "Consulter le journal des actions sensibles",
        "description": "Promotions, désactivations de compte, retraits de dossier et diffusions d'alerte, avec leur auteur, leur cible et la date.\n\n**Rôle requis :** `direction`",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Entrées du journal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AuditLog" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Users"],
        "summary": "Détail d'un compte",
        "description": "**Rôle requis :** `superviseur`",
        "responses": {
          "200": {
            "description": "Compte",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/users/{id}/deactivate": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "patch": {
        "tags": ["Users"],
        "summary": "Désactiver un compte",
        "description": "Inscrit `USER_DEACTIVATED` au journal d'audit.\n\n**Rôle requis :** `superviseur`",
        "responses": {
          "200": {
            "description": "Compte modifié",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/users/{id}/reactivate": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "patch": {
        "tags": ["Users"],
        "summary": "Réactiver un compte",
        "description": "Inscrit `USER_REACTIVATED` au journal d'audit.\n\n**Rôle requis :** `superviseur`",
        "responses": {
          "200": {
            "description": "Compte modifié",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/users/{id}/promote": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "patch": {
        "tags": ["Users"],
        "summary": "Promouvoir un policier",
        "description": "Change le rôle et le grade. Inscrit `USER_PROMOTED` au journal d'audit.\n\n**Rôle requis :** `direction`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Promotion" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compte promu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Grade invalide ou incompatible avec le rôle",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Rôle insuffisant ou tentative de modifier son propre rôle",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": ["Alerts"],
        "summary": "Liste des alertes",
        "description": "Les plus récentes en premier (20 par page par défaut).\n\n**Rôle requis :** `policier`",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Page d'alertes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": { "type": "integer" },
                    "limit": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Alert" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Alerts"],
        "summary": "Diffuser une alerte",
        "description": "Enregistre l'alerte, l'inscrit au journal d'audit et la diffuse à tous les agents connectés (`alert:broadcast`).\n\n**Rôle requis :** `superviseur`",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlertCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alerte diffusée",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "alert": { "$ref": "#/components/schemas/Alert" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "crimetracker_session",
        "description": "Cookie httpOnly posé par POST /api/auth/login (utilisé par le frontend)."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "example": 1 }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 10 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Données invalides ou champs obligatoires manquants",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Jeton absent, invalide ou expiré",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Rôle insuffisant pour cette action",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Ressource introuvable",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "ServerError": {
        "description": "Erreur serveur",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Erreur serveur" }
        }
      },
      "Role": {
        "type": "string",
        "enum": ["policier", "superviseur", "direction"]
      },
      "Grade": {
        "type": "string",
        "enum": [
          "sergent_autres_fonctions",
          "sergent_gestionnaire",
          "sergent_responsable_de_poste",
          "lieutenant",
          "capitaine",
          "inspecteur",
          "inspecteur_chef",
          "directeur_general_adjoint",
          "directeur_general"
        ]
      },
      "CriminalStatus": {
        "type": "string",
        "enum": ["recherche", "capture", "libere"],
        "description": "recherche = recherché, capture = capturé, libere = libéré"
      },
      "Severity": {
        "type": "string",
        "enum": ["info", "urgent"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["badge_number", "password"],
        "properties": {
          "badge_number": { "type": "string", "example": "P-1001" },
          "password": { "type": "string", "format": "password", "example": "motdepasse" },
          "se_souvenir": { "type": "boolean", "example": false }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Connexion réussie" },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 1 },
              "first_name": { "type": "string", "example": "Marie" },
              "last_name": { "type": "string", "example": "Tremblay" },
              "badge_number": { "type": "string", "example": "P-1001" },
              "role": { "$ref": "#/components/schemas/Role" },
              "grade": { "$ref": "#/components/schemas/Grade" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "first_name": { "type": "string", "example": "Marie" },
          "last_name": { "type": "string", "example": "Tremblay" },
          "badge_number": { "type": "string", "example": "P-1001" },
          "email": { "type": "string", "format": "email", "example": "marie.tremblay@police.qc.ca" },
          "role": { "$ref": "#/components/schemas/Role" },
          "grade": { "$ref": "#/components/schemas/Grade" },
          "is_active": { "type": "boolean", "example": true },
          "avatar_url": { "type": "string", "nullable": true, "example": "/api/uploads/avatars/1-1759400000000.png" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": ["first_name", "last_name", "badge_number", "email", "password"],
        "properties": {
          "first_name": { "type": "string", "maxLength": 100, "example": "Marie" },
          "last_name": { "type": "string", "maxLength": 100, "example": "Tremblay" },
          "badge_number": { "type": "string", "maxLength": 20, "example": "P-1001" },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "marie.tremblay@police.qc.ca"
          },
          "password": { "type": "string", "format": "password", "example": "motdepasse" }
        }
      },
      "Promotion": {
        "type": "object",
        "required": ["role", "grade"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["superviseur"],
            "example": "superviseur"
          },
          "grade": { "$ref": "#/components/schemas/Grade" }
        },
        "example": { "role": "superviseur", "grade": "lieutenant" }
      },
      "CriminalSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "first_name": { "type": "string", "example": "Jean" },
          "last_name": { "type": "string", "example": "Dupont" },
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "photo_url": { "type": "string", "nullable": true, "example": "/uploads/photos/1.jpg" }
        }
      },
      "Criminal": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "first_name": { "type": "string", "example": "Jean" },
          "last_name": { "type": "string", "example": "Dupont" },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "1985-04-12"
          },
          "nationality": { "type": "string", "nullable": true, "example": "Canadienne" },
          "photo_url": { "type": "string", "nullable": true, "example": "/uploads/photos/1.jpg" },
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Cicatrice sur la joue gauche"
          },
          "crimes": { "type": "string", "nullable": true, "example": "Vol à main armée" },
          "added_by": { "type": "integer", "example": 1 },
          "updated_by": { "type": "integer", "nullable": true, "example": 2 },
          "version": {
            "type": "integer",
            "example": 1,
            "description": "Incrémentée à chaque mise à jour (verrouillage optimiste)"
          },
          "added_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CriminalCreate": {
        "type": "object",
        "required": ["first_name", "last_name"],
        "properties": {
          "first_name": { "type": "string", "maxLength": 100, "example": "Jean" },
          "last_name": { "type": "string", "maxLength": 100, "example": "Dupont" },
          "date_of_birth": { "type": "string", "format": "date", "example": "1985-04-12" },
          "nationality": { "type": "string", "maxLength": 100, "example": "Canadienne" },
          "description": { "type": "string", "example": "Cicatrice sur la joue gauche" },
          "crimes": { "type": "string", "example": "Vol à main armée" },
          "photo_url": { "type": "string", "maxLength": 500, "example": "/uploads/photos/1.jpg" }
        }
      },
      "CriminalUpdate": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string", "example": "Jean" },
          "last_name": { "type": "string", "example": "Dupont" },
          "description": { "type": "string", "example": "Cicatrice sur la joue gauche" },
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "photo_url": { "type": "string", "example": "/uploads/photos/1.jpg" }
        }
      },
      "CriminalStatusUpdate": {
        "type": "object",
        "required": ["status", "version"],
        "properties": {
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "version": {
            "type": "integer",
            "example": 1,
            "description": "Version lue par le client avant la modification"
          }
        }
      },
      "VersionConflict": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Conflit de version : ce dossier a été modifié entre-temps"
          },
          "criminal": { "$ref": "#/components/schemas/Criminal" }
        }
      },
      "DossierCreate": {
        "type": "object",
        "required": ["first_name", "last_name", "added_by"],
        "properties": {
          "first_name": { "type": "string", "example": "Jean" },
          "last_name": { "type": "string", "example": "Dupont" },
          "description": { "type": "string", "example": "Cicatrice sur la joue gauche" },
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "added_by": { "type": "integer", "example": 1 }
        }
      },
      "DossierUpdate": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string", "example": "Jean" },
          "last_name": { "type": "string", "example": "Dupont" },
          "description": { "type": "string", "example": "Cicatrice sur la joue gauche" },
          "status": { "$ref": "#/components/schemas/CriminalStatus" },
          "photo_url": { "type": "string", "example": "/uploads/photos/1.jpg" }
        }
      },
      "DossierResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Dossier mis à jour avec succès" },
          "criminal": { "$ref": "#/components/schemas/Criminal" }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 9 },
          "sender_id": { "type": "integer", "example": 3 },
          "recipient_id": { "type": "integer", "example": 2 },
          "body": { "type": "string", "example": "Suspect vu au métro Berri-UQAM." },
          "created_at": { "type": "string", "format": "date-time" },
          "read_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 2 },
          "first_name": { "type": "string", "example": "Eric" },
          "last_name": { "type": "string", "example": "Tremblay" },
          "badge_number": { "type": "string", "example": "SM-002" },
          "role": { "type": "string", "enum": ["policier", "superviseur", "direction"] },
          "grade": { "type": "string", "example": "lieutenant" },
          "avatar_url": { "type": "string", "nullable": true },
          "unread": { "type": "integer", "example": 2 },
          "last_message_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Sighting": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "criminal_id": { "type": "integer", "example": 1 },
          "reported_by": { "type": "string", "description": "Nom de l'agent", "example": "Michael Fortin" },
          "criminal_name": { "type": "string", "example": "Jean Dupont" },
          "criminal_status": { "type": "string", "enum": ["recherche", "capture", "libere"] },
          "location": { "type": "string", "example": "Station Berri-UQAM, Montréal" },
          "notes": { "type": "string", "nullable": true, "example": "Portait un manteau noir" },
          "latitude": { "type": "number", "nullable": true, "example": 45.5153 },
          "longitude": { "type": "number", "nullable": true, "example": -73.561 },
          "reported_at": { "type": "string", "format": "date-time" }
        }
      },
      "SightingCreate": {
        "type": "object",
        "required": ["criminal_id", "location"],
        "properties": {
          "criminal_id": { "type": "integer", "example": 1 },
          "location": {
            "type": "string",
            "maxLength": 255,
            "example": "Station Berri-UQAM, Montréal"
          },
          "notes": { "type": "string", "example": "Portait un manteau noir" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90, "description": "Facultative, avec longitude", "example": 45.5153 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180, "description": "Facultative, avec latitude", "example": -73.561 },
          "reported_at": {
            "type": "string",
            "format": "date-time",
            "description": "Heure de l'observation (par défaut : maintenant)"
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "actor_id": { "type": "integer", "example": 5 },
          "action": { "type": "string", "example": "user.promotion" },
          "target_type": { "type": "string", "example": "user" },
          "target_id": { "type": "integer", "example": 3 },
          "details": {
            "type": "object",
            "nullable": true,
            "example": { "grade": "lieutenant" }
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Paginated": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 10 },
          "total": { "type": "integer", "example": 42 },
          "totalPages": { "type": "integer", "example": 5 }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "criminal_id": { "type": "integer", "nullable": true, "example": 1 },
          "message": { "type": "string", "example": "Individu dangereux aperçu au centre-ville" },
          "severity": { "$ref": "#/components/schemas/Severity" },
          "issued_by": { "type": "string", "example": "Marie Tremblay" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AlertCreate": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "Individu dangereux aperçu au centre-ville" },
          "severity": { "$ref": "#/components/schemas/Severity" },
          "criminal_id": { "type": "integer", "nullable": true, "example": 1 }
        }
      }
    }
  }
}
