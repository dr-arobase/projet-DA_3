# Copier en .env (le fichier .env n'est pas versionné : il contient des secrets).

# OWNER : le compte GitHub qui publie les images, en minuscules.
# TAG   : latest, ou un tag sha-xxxxxxx pour épingler une version.
OWNER=dr-arobase
TAG=latest

# Le mot de passe de la base, choisi ici une fois pour toutes : il crée
# l'utilisateur au premier démarrage et sert ensuite à l'API.
POSTGRES_PASSWORD=changez-moi

# Clé obligatoire qui signe les jetons de session (32 octets aléatoires ou plus sont recommandés).
# Remplacez la valeur vide avant de démarrer le déploiement.
JWT_SECRET=30619023bd42cc004289e071ac917ee4dec5ce8e8735dd6d44b6f6077897ba71

# Origine(s) publique(s) exacte(s) de l'application, pour Socket.IO et les requêtes HTTP mutantes.
# Séparées par des virgules.
# Ex. : https://crimetracker.votre-domaine.ca
SOCKET_ALLOWED_ORIGINS=

# true si la machine sert l'application en HTTPS (cookie envoyé seulement en HTTPS)
COOKIE_SECURE=false

# Port sur lequel ouvrir l'application
CLIENT_PORT=8080
