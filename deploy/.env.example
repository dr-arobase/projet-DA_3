# Copier en .env (le fichier .env n'est pas versionné : il contient des secrets).

# OWNER : le compte GitHub qui publie les images, en minuscules.
# TAG   : latest, ou un tag sha-xxxxxxx pour épingler une version.
OWNER=dr-arobase
TAG=latest

# Le mot de passe de la base, choisi ici une fois pour toutes : il crée
# l'utilisateur au premier démarrage et sert ensuite à l'API.
POSTGRES_PASSWORD=changez-moi

# La clé qui signe les jetons de session : une longue chaîne aléatoire.
JWT_SECRET=changez-moi-aussi

# true si la machine sert l'application en HTTPS (cookie envoyé seulement en HTTPS)
COOKIE_SECURE=false

# Port sur lequel ouvrir l'application
CLIENT_PORT=8080
